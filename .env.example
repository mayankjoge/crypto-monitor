# Example only: Flask does not auto-load .env; export these values in your shell.
# Optional CoinGecko demo key (server-side only; public endpoints may work without it)
COINGECKO_API_KEY=your_demo_key_here
# Set to 1 to use clearly-labelled MOCK data. The supplied run scripts default to 1.
MOCK_MODE=0
HOST=127.0.0.1
PORT=5000
CACHE_TTL_MARKETS=60
CACHE_TTL_HISTORY=300
STALE_AFTER_SECONDS=600
