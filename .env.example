# Copy to .env (or export in your shell). Never commit real keys.
# Optional CoinGecko demo key (server-side only; public endpoints work without it)
COINGECKO_API_KEY=your_demo_key_here
# Set to 1 to use clearly-labeled MOCK data (no network). Default 0 = live CoinGecko
MOCK_MODE=0
CACHE_TTL_MARKETS=60
CACHE_TTL_HISTORY=300
STALE_AFTER_SECONDS=600
PORT=5000
